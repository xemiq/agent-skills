  "assumptions": [
    {
      "text": "Team name is unique across the company and identifies a Team.",
      "confirmed_by": "stated"
    },
    {
      "text": "Every project belongs to exactly one team (total participation of Project in Owns).",
      "confirmed_by": "stated"
    },
    {
      "text": "Tasks are numbered within their project, so Task is a weak entity of Project with partial key Task #.",
      "confirmed_by": "stated"
    },
    {
      "text": "Every team has at least one member (total participation of Team in Member of).",
      "confirmed_by": "user"
    },
    {
      "text": "A task is assigned to at most one user; unassigned tasks are allowed.",
      "confirmed_by": "user"
    },
    {
      "text": "A user can have many tasks assigned.",
      "confirmed_by": "user"
    },
    {
      "text": "A user can belong to several teams.",
      "confirmed_by": "user"
    },
    {
      "text": "Partial participation, shown as (default) in the confirmed draft: User in Member of, Project in Contains, User and Task in Assigned to, both ends of Mentors.",
      "confirmed_by": "user"
    },
    {
      "text": "A user has at most one mentor and may mentor many users.",
      "confirmed_by": "user"
    },
    {
      "text": "The role is held per team membership, so Team role is an attribute of Member of.",
      "confirmed_by": "user"
    },
    {
      "text": "Task status values are To do, In progress, Done.",
      "confirmed_by": "user"
    },
    {
      "text": "A user cannot mentor themselves.",
      "confirmed_by": "user"
    },
    {
      "text": "Created on (Team) and Is active (User) are business data requested in the description, not technical audit columns.",
      "confirmed_by": "stated"
    }
  ],
